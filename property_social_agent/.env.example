# =============================================================================
# Secrets for the Property Social Agent.
# Copy this file to ".env" and fill in real values. NEVER commit your real .env.
# =============================================================================

# --- Claude / Anthropic (content generation) --------------------------------
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Meta Graph API (Instagram + Facebook Page) -----------------------------
# A long-lived Page access token with instagram_basic, instagram_content_publish,
# pages_manage_posts, pages_read_engagement permissions.
# See README "Meta setup" for how to obtain these.
META_ACCESS_TOKEN=
# The Instagram Business/Creator account ID (linked to the Page below)
IG_BUSINESS_ACCOUNT_ID=
# The Facebook Page ID you publish to
FB_PAGE_ID=

# --- Email approval (outbound SMTP) -----------------------------------------
# For Gmail, create an "App Password" (not your normal password):
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password

# --- Email approval (inbound IMAP, to read your "APPROVE" reply) -------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=you@gmail.com
IMAP_PASSWORD=your-app-password

# --- Optional: S3-compatible image host (only if image_host.type = s3) -------
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional custom endpoint for non-AWS S3 (e.g. Cloudflare R2, MinIO)
S3_ENDPOINT_URL=
